# Dependencies
node_modules/
vendor/

# Build output
dist/
public/build/
public/storage/

# Environment secrets - never commit these
.env
.env.*
!.env.example
!.env.production.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
storage/logs/

# Database backups - DB_BACKUP_DIR can point to any folder under storage/app,
# so ignore both the known folders and the dump file patterns themselves.
storage/app/backups/
storage/app/env-backups/
storage/app/custom-backups/
storage/app/**/*.sql
storage/app/**/*.sql.gz
storage/app/public/*
!storage/app/public/.gitkeep
storage/app/private/*
!storage/app/private/.gitkeep

# Local env overrides
*.local

# Android signing material - never commit a keystore or its passwords
*.jks
*.keystore
**/key.properties

# Testing
coverage/
.phpunit.result.cache
playwright-report/
test-results/
storage/framework/testing/

# Laravel generated files
storage/*.key
storage/framework/cache/data/*
!storage/framework/cache/data/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
bootstrap/cache/*.php
!bootstrap/cache/.gitkeep

# Agent workspace
.kilo/
.vite/
.claude/
.codex/
.agents/

# Security patches and artifacts
MedSurvey-Pro-security-fixes.diff
SECURITY_FIXES_APPLIED.md
