#!/usr/bin/env bash
# Single-host release deployment. See docs/production-readiness.md.
set -Eeuo pipefail
umask 027
root=$(realpath -e "${1:?usage: deploy-medsurvey ROOT COMMIT}")
revision=${2:?provide the approved Git commit}
[[ $revision =~ ^[0-9a-f]{7,40}$ && -L "$root/current" ]]
previous=$(realpath -e "$root/current")
[[ $previous == "$root/releases/"* && -f "$previous/artisan" ]]
exec 9>"$root/deploy.lock"
flock -n 9 || { echo 'Another deployment holds the lock.' >&2; exit 1; }
for cmd in git tar sha256sum composer npm php curl df awk mktemp gzip sed tee; do command -v "$cmd" >/dev/null; done
for hook in check pause reload resume; do test -x "$root/hooks/$hook"; done
test -r "$root/shared/.env"
test -w "$root/shared/storage/framework"
test -w "$root/releases"
test -w "$root/recovery"
test -n "${HEALTH_URL:?set the readiness URL ending in /api/health}"
sha=$(git -C "$root/repo" rev-parse --verify "$revision^{commit}")
available=$(df -Pk "$root" | awk 'END {print $4}')
[[ $available -ge ${MIN_FREE_KIB:-1048576} ]] || { echo 'Insufficient release space.' >&2; exit 1; }
"$root/hooks/check" "$previous"
release=$(mktemp -d "$root/releases/${sha:0:12}.XXXXXXXX")
state=$(mktemp -d "$root/recovery/${sha:0:12}.XXXXXXXX")
chmod 700 "$state"
printf '%s\n' "$previous" > "$state/previous"
printf '%s\n' "$sha" > "$state/target"
exec > >(tee -a "$state/deploy.log") 2>&1
phase=prepare
down=0
paused=0
database_started=0
app() { (cd "$1" && shift && php artisan "$@"); }
finish() {
  local rc=$?
  trap - EXIT
  if ((rc)); then
    echo "Deployment failed during $phase. Recovery record: $state" >&2
    if (( database_started )); then
      app "$root/current" down || echo 'Drain HTTP at the reverse proxy immediately.' >&2
      "$root/hooks/pause" "$root/current" || echo 'Check workers and scheduler manually.' >&2
      echo 'Verify the schema, release and recovery archive before resuming services and running artisan up.' >&2
    else
      if (( paused )); then "$root/hooks/resume" "$previous" || { echo 'Services need manual recovery.' >&2; exit "$rc"; }; fi
      if (( down )); then app "$previous" up || echo 'Run artisan up after checking services.' >&2; fi
    fi
  fi
  exit "$rc"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
echo "$(date -u +%FT%TZ) Preparing $sha in $release"
git -C "$root/repo" archive "$sha" | tar -x -C "$release"
cd "$release"
composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader --no-scripts
npm ci --no-fund
npm run build
test -s public/sw.js
test -s public/manifest.webmanifest
# Keep old hashed assets addressable for open tabs. The shared asset store
# is outside user uploads and contains immutable build files only.
mkdir -p "$root/shared/assets"
cp -an "$previous/public/build/assets/." "$root/shared/assets/"
cp -an public/build/assets/. "$root/shared/assets/"
mv public/build/assets "$release/.built-assets"
ln -s "$root/shared/assets" public/build/assets
ln -s "$root/shared/.env" .env
mv storage "$release/.storage-skeleton"
ln -s "$root/shared/storage" storage
test "$(realpath -e "$previous/storage")" = "$(realpath -e storage)"
# A database/cache flush may erase cache-based maintenance. File mode is
# checked against the effective config of both releases before migration.
check_driver() { (cd "$1" && php -r 'require "vendor/autoload.php"; $a=require "bootstrap/app.php"; $a->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap(); exit(config("app.maintenance.driver")==="file" ? 0 : 1);'); }
check_driver "$previous"
check_driver "$release"
test ! -e storage/framework/down || { echo 'Maintenance already belongs to another operation.' >&2; exit 1; }
phase=maintenance
app "$previous" down
down=1
test -f storage/framework/down
paused=1
"$root/hooks/pause" "$previous"
phase=backup
# Invoking the original release's service also supports the first upgrade
# from releases predating the CLI's --print-path option.
(cd "$previous" && php -r 'require "vendor/autoload.php"; $a=require "bootstrap/app.php"; $a->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap(); $b=$a->make(App\Services\BackupService::class)->create(); if (!($b["verification"]["valid"]??false)) exit(1); echo "BACKUP_FILE=",$b["file"],PHP_EOL;') | tee "$state/backup.log"
dump=$(sed -n 's/^BACKUP_FILE=//p' "$state/backup.log")
test -f "$dump"
test -s "$dump"
cp "$dump" "$state/"
dumpname=$(basename "$dump")
if [[ $dumpname == *.gz ]]; then gzip -t "$state/$dumpname"; fi
tar -czf "$state/uploads.tar.gz" -C "$root/shared/storage/app" public private
tar -tzf "$state/uploads.tar.gz" >/dev/null
(cd "$state" && sha256sum "$dumpname" uploads.tar.gz > SHA256SUMS && sha256sum -c SHA256SUMS)
phase=migration
app "$release" package:discover
test -f storage/framework/down
database_started=1
app "$release" migrate --force --no-interaction
app "$release" storage:link
app "$release" config:cache
app "$release" route:cache
app "$release" view:cache
app "$release" migrate:status
test -f storage/framework/down
phase=activate
ln -s "$release" "$state/next"
mv -Tf "$state/next" "$root/current"
"$root/hooks/reload" "$release"
"$root/hooks/resume" "$release"
app "$release" up
phase=readiness
curl --fail --silent --show-error --max-time 15 "$HEALTH_URL" |
  php -r '$r=json_decode(stream_get_contents(STDIN),true); exit(($r["status"]??null)==="ok" ? 0 : 1);'
echo "$(date -u +%FT%TZ) Deployment healthy: $sha"
