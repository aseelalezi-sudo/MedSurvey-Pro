# Include inside every serving public/LAN server. Keep the existing TLS/tunnel listeners.
root /var/www/medsurvey-releases/current/public;
index index.php;
autoindex off;
if (-f /var/www/medsurvey-releases/traffic.closed) { return 503 "medsurvey-maintenance"; }

location / { try_files $uri $uri/ /index.php?$query_string; }
location = /index.php {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
    fastcgi_pass unix:/run/php/php8.2-fpm.sock;
}
location ~ /\. { return 404; }
location ~* \.(?:php[0-9]?|phtml|phar|sql|gz|bak|env)(?:/|$) { return 404; }
location /storage/ {
    disable_symlinks on from=$document_root/storage;
    try_files $uri =404;
}
# Backend publishing uses loopback directly. Expose only the client socket.
location /apps/ { return 404; }
location /app/ {
    access_log off;
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
}
